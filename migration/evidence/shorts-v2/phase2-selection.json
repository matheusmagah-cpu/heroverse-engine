{
 "chosen": [
  {
   "start": 459.86,
   "end": 499.672,
   "hook": "Lord, protect my relationships.",
   "title": "A Prayer for Peace in Your Relationships",
   "reference": null,
   "sentences": [
    {
     "segment": "prayer-relationships",
     "text": "Lord, protect my relationships.",
     "start": 459.86,
     "end": 462.527
    },
    {
     "segment": "prayer-relationships",
     "text": "Guard marriages from coldness and from anything that would divide them.",
     "start": 462.707,
     "end": 467.976
    },
    {
     "segment": "prayer-relationships",
     "text": "Protect friendships from gossip and misunderstanding.",
     "start": 468.156,
     "end": 472.316
    },
    {
     "segment": "prayer-relationships",
     "text": "Where there is tension, bring honest conversations and quick forgiveness.",
     "start": 472.496,
     "end": 477.659
    },
    {
     "segment": "prayer-relationships",
     "text": "Let love win in every home today.",
     "start": 477.839,
     "end": 480.633
    },
    {
     "segment": "prayer-words",
     "text": "Father, set a guard over my mouth today.",
     "start": 482.013,
     "end": 485.277
    },
    {
     "segment": "prayer-words",
     "text": "Protect me from words I would regret:",
     "start": 485.457,
     "end": 488.444
    },
    {
     "segment": "prayer-words",
     "text": "harsh words, careless words, words spoken in anger.",
     "start": 488.624,
     "end": 492.955
    },
    {
     "segment": "prayer-words",
     "text": "Let what I say build people up.",
     "start": 493.135,
     "end": 495.503
    },
    {
     "segment": "prayer-words",
     "text": "Let my words carry your peace into every room I enter.",
     "start": 495.683,
     "end": 499.672
    }
   ],
   "segments": [
    "prayer-relationships",
    "prayer-words"
   ],
   "text": "Lord, protect my relationships. Guard marriages from coldness and from anything that would divide them. Protect friendships from gossip and misunderstanding. Where there is tension, bring honest conversations and quick forgiveness. Let love win in every home today. Father, set a guard over my mouth today. Protect me from words I would regret: harsh words, careless words, words spoken in anger. Let what I say build people up. Let my words carry your peace into every room I enter."
  }
 ],
