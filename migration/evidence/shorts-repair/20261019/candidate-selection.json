   "sentences": [
    {
     "segment": "declaration",
     "text": "I can tell the truth about this day.",
     "start": 969.668,
     "end": 972.463
    },
    {
     "segment": "declaration",
     "text": "I can name the mercy I received.",
     "start": 972.643,
     "end": 975.395
    },
    {
     "segment": "declaration",
     "text": "I can bring the hurt I still carry.",
     "start": 975.575,
     "end": 978.284
    },
    {
     "segment": "declaration",
     "text": "God’s faithfulness is worthy of my thanks even when my understanding is incomplete.",
     "start": 978.464,
     "end": 985.312
    },
    {
     "segment": "declaration",
     "text": "I will honor the help that came through other people.",
     "start": 985.492,
     "end": 989.033
    },
    {
     "segment": "declaration",
     "text": "I will receive care without shame and offer kindness within my limits.",
     "start": 989.213,
     "end": 994.696
    },
    {
     "segment": "declaration",
     "text": "I entrust this evening to the Lord, carrying gratitude and honest need into the same prayer.",
     "start": 994.876,
     "end": 1001.937
    }
   ],
