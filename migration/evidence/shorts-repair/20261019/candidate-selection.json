  {
   "start": 618.453,
   "end": 657.064,
   "sentences": [
    {
     "segment": "prayer-correction",
     "text": "Receive my willingness to learn.",
     "start": 618.453,
     "end": 620.843
    },
    {
     "segment": "reflection-people-details",
     "text": "You can remember one person through a small detail rather than a general description.",
     "start": 622.223,
     "end": 628.431
    },
    {
     "segment": "reflection-people-details",
     "text": "Perhaps you hear the patience in their voice or picture the chair they pulled closer.",
     "start": 628.611,
     "end": 634.477
    },
    {
     "segment": "reflection-people-details",
     "text": "If you received a message, you might recall the sentence that helped you feel remembered.",
     "start": 634.657,
     "end": 640.759
    },
    {
     "segment": "reflection-people-details",
     "text": "You can thank God for that exact kindness.",
     "start": 640.939,
     "end": 644.288
    },
    {
     "segment": "reflection-people-details",
     "text": "You may remember help offered awkwardly but sincerely.",
     "start": 644.468,
     "end": 648.457
    },
    {
     "segment": "reflection-people-details",
     "text": "Let your attention rest on what you truly received, without requiring that person to have done everything perfectly.",
     "start": 648.637,
     "end": 657.064
    }
   ],
   "segments": [
    "prayer-correction",
    "reflection-people-details"
   ],
   "reference": null,
   "measured_score": 0.6946,
   "features": {
    "opening_short": 1.0,
    "opening_direct": 0.3,
    "second_person": 1.0,
