   "final_score": 0.6659,
   "hook": "Now recall the middle of your day.",
   "title": "Now recall the middle of your day."
  },
  {
   "start": 95.82,
   "end": 135.601,
   "sentences": [
    {
     "segment": "reflection-first-detail",
     "text": "Perhaps you had a few minutes outside.",
     "start": 95.82,
     "end": 98.572
    },
    {
     "segment": "reflection-first-detail",
     "text": "Choose something that really happened to you.",
     "start": 98.752,
     "end": 101.611
    },
    {
     "segment": "reflection-first-detail",
     "text": "As you recall that detail, you can acknowledge the good it carried.",
     "start": 101.791,
     "end": 106.676
    },
    {
     "segment": "reflection-first-detail",
     "text": "Let your thanks have the shape of an actual moment, with a place, a person, or a simple object.",
     "start": 106.856,
     "end": 114.323
    },
    {
     "segment": "prayer-early-hours",
     "text": "Lord, I remember the beginning of this day.",
     "start": 115.703,
     "end": 118.817
    },
    {
     "segment": "prayer-early-hours",
     "text": "I thank you for whatever helped me enter it:",
     "start": 118.997,
     "end": 122.283
    },
    {
     "segment": "prayer-early-hours",
     "text": "a familiar voice, a working light, clothing I could put on, or a little food before leaving.",
     "start": 122.463,
     "end": 129.204
    },
    {
     "segment": "prayer-early-hours",
     "text": "I often hurry past these familiar things.",
     "start": 129.384,
     "end": 132.541
    },
    {
     "segment": "prayer-early-hours",
     "text": "Tonight I receive them with attention.",
     "start": 132.721,
     "end": 135.601
    }
   ],
   "segments": [
    "reflection-first-detail",
    "prayer-early-hours"
   ],
