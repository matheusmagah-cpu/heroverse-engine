  {
   "start": 453.663,
   "end": 499.591,
   "sentences": [
    {
     "segment": "stillness-first",
     "text": "Let your breathing continue naturally.",
     "start": 453.663,
     "end": 456.564
    },
    {
     "segment": "stillness-first",
     "text": "You can let that small mercy be present while the music carries this quiet space.",
     "start": 456.744,
     "end": 462.739
    },
    {
     "segment": "prayer-one-mercy",
     "text": "Lord, I thank you for this particular mercy I have remembered.",
     "start": 468.919,
     "end": 473.569
    },
    {
     "segment": "prayer-one-mercy",
     "text": "I want to receive its goodness instead of rushing beyond it.",
     "start": 473.749,
     "end": 478.251
    },
    {
     "segment": "prayer-one-mercy",
     "text": "If another person offered it, bless the life behind that gesture, including the concerns I know nothing about.",
     "start": 478.431,
     "end": 486.815
    },
    {
     "segment": "prayer-one-mercy",
     "text": "Help me remember that I also move through the days of others.",
     "start": 486.995,
     "end": 491.432
    },
    {
     "segment": "prayer-one-mercy",
     "text": "Let the care I have received shape how I speak, how I wait, and how I notice the next person before me.",
     "start": 491.612,
     "end": 499.591
    }
   ],
   "segments": [
    "stillness-first",
    "prayer-one-mercy"
   ],
