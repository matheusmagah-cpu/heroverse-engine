{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rapidapi-youtube-reference": {
      "type": "streamable-http",
      "url": "https://mcp.rapidapi.com",
      "headers": {
        "x-api-host": "youtube-info-download-api.p.rapidapi.com"
      },
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "api_key",
            "headerScheme": "custom_header",
            "headerName": "x-api-key"
          }
        }
      }
    }
  }
}
