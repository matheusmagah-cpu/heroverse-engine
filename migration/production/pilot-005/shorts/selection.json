   "sentences": [
    {
     "segment": "reflection-6",
     "text": "You are not protected because you are perfect.",
     "start": 729.528,
     "end": 733.176
    },
    {
     "segment": "reflection-6",
     "text": "You are protected because you are his.",
     "start": 733.356,
     "end": 736.321
    },
    {
     "segment": "prayer-thanks",
     "text": "Thank you, Father, for every time you have protected me without my even knowing it.",
     "start": 737.701,
     "end": 743.632
    },
    {
     "segment": "prayer-thanks",
     "text": "The accidents that did not happen.",
     "start": 743.812,
     "end": 746.479
    },
    {
     "segment": "prayer-thanks",
     "text": "The dangers I never saw.",
     "start": 746.659,
     "end": 748.941
    },
    {
     "segment": "prayer-thanks",
     "text": "Thank you for keeping me until this morning.",
     "start": 749.121,
     "end": 752.428
    },
    {
     "segment": "prayer-thanks",
     "text": "I trust you to keep me today.",
     "start": 752.608,
     "end": 754.997
    },
    {
     "segment": "prayer-purpose",
     "text": "Lord, make me a shelter for others today.",
     "start": 756.377,
     "end": 759.492
    },
    {
     "segment": "prayer-purpose",
     "text": "Let me notice the person who feels unsafe, and offer kindness, help and prayer.",
     "start": 759.672,
     "end": 765.923
    },
    {
     "segment": "prayer-purpose",
     "text": "As you protect me, let me protect the weak and speak up for those who cannot.",
     "start": 766.103,
     "end": 771.393
    }
   ],
   "segments": [
