     "end": 243.293
    },
    {
     "segment": "reflection-3",
     "text": "Not only in church, not only on good days.",
     "start": 243.473,
     "end": 247.164
    },
    {
     "segment": "reflection-3",
     "text": "On the highway, at the office, in the hospital waiting room, on the walk home.",
