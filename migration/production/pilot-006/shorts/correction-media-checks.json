 "editorial_metadata": {
  "caption_source_intervals": [
   {
    "text": "Let your face soften.",
    "start": 0.0,
    "end": 1.941
   },
   {
    "text": "Let your eyes close.",
    "start": 2.121,
    "end": 4.063
   },
   {
    "text": "Let your shoulders drop.",
    "start": 5.443,
    "end": 7.427
   },
   {
    "text": "Let your arms rest heavy at your sides.",
    "start": 7.607,
    "end": 10.615
   },
   {
    "text": "Let your hands open.",
    "start": 10.795,
    "end": 12.715
   },
   {
    "text": "Feel the mattress holding you, the pillow supporting your head.",
    "start": 12.895,
    "end": 17.353
   },
   {
    "text": "You do not have to hold yourself up tonight.",
    "start": 17.533,
    "end": 20.797
   },
   {
    "text": "You are held.",
    "start": 20.977,
    "end": 22.407
   },
   {
    "text": "Let the warmth of rest spread slowly through your chest, your stomach, your hips, your legs, all the way down to your feet.",
    "start": 23.787,
    "end": 32.661
   },
   {
    "text": "Every part of you is known by the God who made you.",
    "start": 32.841,
    "end": 36.831
   },
   {
    "text": "Every cell is in his care.",
    "start": 37.011,
    "end": 39.187
   },
   {
    "text": "Rest now.",
    "start": 39.367,
    "end": 40.689
   }
  ],
