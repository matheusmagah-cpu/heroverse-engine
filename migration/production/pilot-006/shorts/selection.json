     "segment": "sleep-relax-1",
     "text": "Let your eyes close.",
     "start": 815.849,
     "end": 817.791
    },
    {
     "segment": "sleep-relax-2",
     "text": "Let your shoulders drop.",
     "start": 819.171,
     "end": 821.155
    },
    {
     "segment": "sleep-relax-2",
     "text": "Let your arms rest heavy at your sides.",
     "start": 821.335,
     "end": 824.343
