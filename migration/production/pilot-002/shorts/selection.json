  {
   "start": 416.229,
   "end": 453.624,
   "sentences": [
    {
     "segment": "prayer-mind",
     "text": "Bring my thoughts back to this day and to you.",
     "start": 416.229,
     "end": 419.472
    },
    {
     "segment": "prayer-mind",
     "text": "Replace the noise in my head with your peace.",
     "start": 419.652,
     "end": 423.001
    },
    {
     "segment": "prayer-mind",
     "text": "When I start to imagine the worst, remind me of everything you have already carried me through.",
     "start": 423.181,
     "end": 429.837
    },
    {
     "segment": "scripture-8",
     "text": "Before we keep praying, let these words settle over your heart.",
     "start": 431.217,
     "end": 435.676
    },
    {
     "segment": "scripture-8",
     "text": "Be careful for nothing;",
     "start": 435.856,
     "end": 437.819
    },
    {
     "segment": "scripture-8",
     "text": "but in every thing by prayer and supplication with thanksgiving let your requests be made known unto God.",
     "start": 437.999,
     "end": 445.444
    },
    {
     "segment": "scripture-8",
     "text": "And the peace of God, which passeth all understanding, shall keep your hearts and minds through Christ Jesus.",
     "start": 445.624,
     "end": 453.624
    }
   ],
   "segments": [
