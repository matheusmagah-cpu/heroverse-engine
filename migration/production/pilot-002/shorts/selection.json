  {
   "start": 820.973,
   "end": 855.38,
   "sentences": [
    {
     "segment": "scripture-10",
     "text": "Some of you are walking into something heavy today.",
     "start": 820.973,
     "end": 824.493
    },
    {
     "segment": "scripture-10",
     "text": "This promise is for you.",
     "start": 824.673,
     "end": 826.785
    },
    {
     "segment": "scripture-10",
     "text": "When thou passest through the waters, I will be with thee;",
     "start": 826.965,
     "end": 831.083
    },
    {
     "segment": "scripture-10",
     "text": "and through the rivers, they shall not overflow thee:",
     "start": 831.263,
     "end": 834.932
    },
    {
     "segment": "scripture-10",
     "text": "when thou walkest through the fire, thou shalt not be burned;",
     "start": 835.112,
     "end": 839.571
    },
    {
     "segment": "scripture-10",
     "text": "neither shall the flame kindle upon thee.",
     "start": 839.751,
     "end": 842.972
    },
    {
     "segment": "prayer-waters",
     "text": "Notice that God did not say if you pass through the waters.",
     "start": 844.652,
     "end": 848.833
    },
    {
     "segment": "prayer-waters",
     "text": "He said when.",
     "start": 849.013,
     "end": 850.421
    },
    {
     "segment": "prayer-waters",
     "text": "Lord, I will not pretend there are no deep waters in my life.",
     "start": 850.601,
     "end": 855.38
    }
   ],
   "segments": [
    "scripture-10",
    "prayer-waters"
   ],
   "reference": "Isaiah 43:2 (KJV)",
