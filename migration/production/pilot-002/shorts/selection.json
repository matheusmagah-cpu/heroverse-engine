   "sentences": [
    {
     "segment": "reflection-courage",
     "text": "Your courage today does not have to come from feeling ready.",
     "start": 1090.491,
     "end": 1095.035
    },
    {
     "segment": "reflection-courage",
     "text": "It can come from knowing who is with you.",
     "start": 1095.215,
     "end": 1098.009
    },
    {
     "segment": "reflection-courage",
     "text": "Whithersoever thou goest.",
     "start": 1098.189,
     "end": 1100.493
    },
    {
     "segment": "reflection-courage",
     "text": "That means the kitchen, the office, the hospital room, the classroom, the empty apartment.",
     "start": 1100.673,
     "end": 1107.031
    },
    {
     "segment": "reflection-courage",
     "text": "There is no place on your schedule today where he will not be.",
     "start": 1107.211,
     "end": 1111.691
    },
    {
     "segment": "scripture-12",
     "text": "And one more promise, short enough to remember all day.",
