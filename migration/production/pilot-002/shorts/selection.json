  {
   "start": 1123.549,
   "end": 1162.105,
   "sentences": [
    {
     "segment": "prayer-thanks",
     "text": "Father, thank you.",
     "start": 1123.549,
     "end": 1125.192
    },
    {
     "segment": "prayer-thanks",
     "text": "Thank you that you went before me today, that your mercy is new, and that you will never leave me.",
     "start": 1125.372,
     "end": 1132.263
    },
    {
     "segment": "prayer-thanks",
     "text": "Thank you for what you have already done in my life, even the things I only understood later.",
     "start": 1132.443,
     "end": 1139.099
    },
    {
     "segment": "prayer-thanks",
     "text": "I choose to start this day grateful, not because everything is easy, but because you are faithful.",
     "start": 1139.279,
     "end": 1146.532
    },
    {
     "segment": "prayer-thanks",
     "text": "Let my gratitude be louder than my worry today.",
     "start": 1146.712,
     "end": 1150.275
    },
    {
     "segment": "prayer-purpose",
     "text": "Lord, use me today.",
     "start": 1151.655,
     "end": 1153.639
    },
    {
     "segment": "prayer-purpose",
     "text": "Not only to get through my list, but to be part of what you are doing.",
     "start": 1153.819,
     "end": 1158.832
    },
    {
     "segment": "prayer-purpose",
     "text": "Show me one person I can encourage.",
     "start": 1159.012,
     "end": 1162.105
    }
   ],
   "segments": [
    "prayer-thanks",
    "prayer-purpose"
   ],
   "reference": null,
