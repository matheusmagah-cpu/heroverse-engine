  {
   "start": 144.859,
   "end": 182.343,
   "sentences": [
    {
     "segment": "reflection-6",
     "text": "You are following him into it.",
     "start": 144.859,
     "end": 147.291
    },
    {
     "segment": "scripture-2",
     "text": "There is a second promise for this exact hour.",
     "start": 148.671,
     "end": 152.063
    },
    {
     "segment": "scripture-2",
     "text": "It is of the Lord's mercies that we are not consumed, because his compassions fail not.",
     "start": 152.243,
     "end": 158.92
    },
    {
     "segment": "scripture-2",
     "text": "They are new every morning:",
     "start": 159.1,
     "end": 161.361
    },
    {
     "segment": "scripture-2",
     "text": "great is thy faithfulness.",
     "start": 161.541,
     "end": 163.781
    },
    {
     "segment": "reflection-2",
     "text": "New every morning.",
     "start": 165.461,
     "end": 167.339
    },
    {
     "segment": "reflection-2",
     "text": "Not leftover mercy from yesterday.",
     "start": 167.519,
     "end": 170.527
    },
    {
     "segment": "reflection-2",
     "text": "Not the small amount that remains after your mistakes.",
     "start": 170.707,
     "end": 174.824
    },
    {
     "segment": "reflection-2",
     "text": "Fresh mercy, measured for today, for the person you are this morning, with everything you are carrying.",
     "start": 175.004,
     "end": 182.343
    }
   ],
   "segments": [
    "reflection-6",
    "scripture-2",
    "reflection-2"
   ],
