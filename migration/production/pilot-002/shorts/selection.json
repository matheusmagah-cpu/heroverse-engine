  {
   "start": 998.841,
   "end": 1038.773,
   "sentences": [
    {
     "segment": "scripture-5",
     "text": "Carry one more promise with you into the next hour.",
     "start": 998.841,
     "end": 1002.852
    },
    {
     "segment": "scripture-5",
     "text": "Trust in the Lord with all thine heart;",
     "start": 1003.032,
     "end": 1005.763
    },
    {
     "segment": "scripture-5",
     "text": "and lean not unto thine own understanding.",
     "start": 1005.943,
     "end": 1009.569
    },
    {
     "segment": "scripture-5",
     "text": "In all thy ways acknowledge him, and he shall direct thy paths.",
     "start": 1009.749,
     "end": 1014.443
    },
    {
     "segment": "reflection-4",
     "text": "In all thy ways acknowledge him.",
     "start": 1016.123,
     "end": 1018.683
    },
    {
     "segment": "reflection-4",
     "text": "Not only in the big decisions, but in the small ones that fill an ordinary day.",
     "start": 1018.863,
     "end": 1025.028
    },
    {
     "segment": "reflection-4",
     "text": "When you sit down to work, acknowledge him.",
     "start": 1025.208,
     "end": 1028.472
    },
    {
     "segment": "reflection-4",
     "text": "When you answer a difficult message, acknowledge him.",
     "start": 1028.652,
     "end": 1032.641
    },
    {
     "segment": "reflection-4",
     "text": "When you feel the old worry return in the middle of the afternoon, acknowledge him.",
     "start": 1032.821,
     "end": 1038.773
    }
   ],
   "segments": [
    "scripture-5",
    "reflection-4"
   ],
   "reference": "Proverbs 3:5-6 (KJV)",
