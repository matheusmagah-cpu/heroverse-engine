  {
   "start": 1241.588,
   "end": 1273.82,
   "sentences": [
    {
     "segment": "payoff",
     "text": "You were here first.",
     "start": 1241.588,
     "end": 1243.231
    },
    {
     "segment": "payoff",
     "text": "That is all.",
     "start": 1243.411,
     "end": 1244.819
    },
    {
     "segment": "payoff",
     "text": "Six words that turn your attention from the size of the problem to the faithfulness of the One who is already in it.",
     "start": 1244.999,
     "end": 1253.511
    },
    {
     "segment": "blessing",
     "text": "May the Lord go before you into every hour of this day.",
     "start": 1254.891,
     "end": 1259.157
    },
    {
     "segment": "blessing",
     "text": "May his mercy meet you at every turn.",
     "start": 1259.337,
     "end": 1262.537
    },
    {
     "segment": "blessing",
     "text": "May his peace guard your heart when the day gets loud, and may you lie down tonight knowing that he never left your side.",
     "start": 1262.717,
     "end": 1270.888
    },
    {
     "segment": "blessing",
     "text": "In the name of Jesus, amen.",
     "start": 1271.068,
     "end": 1273.82
    }
   ],
   "segments": [
    "payoff",
    "blessing"
   ],
