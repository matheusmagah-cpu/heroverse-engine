 "shortlist": [
  {
   "start": 1090.491,
   "end": 1132.263,
   "sentences": [
    {
     "segment": "reflection-courage",
     "text": "Your courage today does not have to come from feeling ready.",
     "start": 1090.491,
     "end": 1095.035
    },
    {
     "segment": "reflection-courage",
     "text": "It can come from knowing who is with you.",
     "start": 1095.215,
     "end": 1098.009
    },
    {
     "segment": "reflection-courage",
     "text": "Whithersoever thou goest.",
     "start": 1098.189,
     "end": 1100.493
    },
    {
     "segment": "reflection-courage",
     "text": "That means the kitchen, the office, the hospital room, the classroom, the empty apartment.",
     "start": 1100.673,
     "end": 1107.031
    },
    {
     "segment": "reflection-courage",
     "text": "There is no place on your schedule today where he will not be.",
     "start": 1107.211,
     "end": 1111.691
    },
    {
     "segment": "scripture-12",
     "text": "And one more promise, short enough to remember all day.",
     "start": 1113.071,
     "end": 1117.465
    },
    {
     "segment": "scripture-12",
     "text": "For he hath said, I will never leave thee, nor forsake thee.",
     "start": 1117.645,
     "end": 1121.869
    },
    {
     "segment": "prayer-thanks",
     "text": "Father, thank you.",
     "start": 1123.549,
     "end": 1125.192
    },
    {
     "segment": "prayer-thanks",
     "text": "Thank you that you went before me today, that your mercy is new, and that you will never leave me.",
     "start": 1125.372,
     "end": 1132.263
    }
   ],
   "segments": [
    "reflection-courage",
    "scripture-12",
    "prayer-thanks"
   ],
   "reference": "Hebrews 13:5 (KJV)",
   "measured_score": 0.9092,
