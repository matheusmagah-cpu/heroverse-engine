  {
   "start": 666.592,
   "end": 709.863,
   "sentences": [
    {
     "segment": "prayer-provision",
     "text": "I also bring you my needs, the practical ones.",
     "start": 666.592,
     "end": 670.389
    },
    {
     "segment": "prayer-provision",
     "text": "You know what is in my account and what is on my table.",
     "start": 670.569,
     "end": 674.793
    },
    {
     "segment": "prayer-provision",
     "text": "You know the job I hope for and the work I already have.",
     "start": 674.973,
     "end": 679.411
    },
    {
     "segment": "prayer-provision",
     "text": "Provide what I need for today, and teach me to be content and grateful while I wait for what I still hope for.",
     "start": 679.591,
     "end": 687.612
    },
    {
     "segment": "prayer-provision",
     "text": "You have never been late, even when I thought you were.",
     "start": 687.792,
     "end": 691.568
    },
    {
     "segment": "prayer-health",
     "text": "I also lift up my body to you.",
     "start": 692.948,
     "end": 695.7
    },
    {
     "segment": "prayer-health",
     "text": "You know where I am tired, where I hurt, and the results I am waiting for.",
     "start": 695.88,
     "end": 701.32
    },
    {
     "segment": "prayer-health",
     "text": "I ask you for strength and for healing, and I thank you for every doctor, nurse and caregiver you use to help us.",
     "start": 701.5,
     "end": 709.863
    }
   ],
