  {
   "start": 382.324,
   "end": 423.001,
   "sentences": [
    {
     "segment": "prayer-2",
     "text": "You know its name.",
     "start": 382.324,
     "end": 383.945
    },
    {
     "segment": "prayer-2",
     "text": "I will not pretend it is small, and I will not pretend you are smaller.",
     "start": 384.125,
     "end": 389.544
    },
    {
     "segment": "prayer-2",
     "text": "Where I see a closed door, you see the way through.",
     "start": 389.724,
     "end": 393.436
    },
    {
     "segment": "prayer-2",
     "text": "Where I see a delay, you see the right time.",
     "start": 393.616,
     "end": 397.029
    },
    {
     "segment": "prayer-2",
     "text": "Teach my heart to rest in what you know, even when I do not know it yet.",
     "start": 397.209,
     "end": 402.628
    },
    {
     "segment": "prayer-mind",
     "text": "Lord, you know how quickly my thoughts run ahead of me.",
     "start": 404.008,
     "end": 407.699
    },
    {
     "segment": "prayer-mind",
     "text": "Before I have finished my coffee, my mind is already in tomorrow, rehearsing problems that may never come.",
     "start": 407.879,
     "end": 416.049
    },
    {
     "segment": "prayer-mind",
     "text": "Bring my thoughts back to this day and to you.",
     "start": 416.229,
     "end": 419.472
    },
    {
     "segment": "prayer-mind",
     "text": "Replace the noise in my head with your peace.",
     "start": 419.652,
     "end": 423.001
    }
   ],
   "segments": [
    "prayer-2",
    "prayer-mind"
   ],
   "reference": null,
   "measured_score": 0.8668,
   "features": {
