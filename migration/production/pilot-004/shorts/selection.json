     "start": 446.584,
     "end": 452.707
    },
    {
     "segment": "prayer-mind",
     "text": "Replace every anxious thought with a promise from your word.",
     "start": 452.887,
     "end": 457.132
    },
    {
     "segment": "prayer-mind",
     "text": "Let my last thoughts tonight be thoughts of your goodness.",
     "start": 457.312,
     "end": 460.896
    },
    {
     "segment": "scripture-9",
     "text": "Jesus said, Peace I leave with you, my peace I give unto you:",
