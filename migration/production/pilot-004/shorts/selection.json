   "sentences": [
    {
     "segment": "prayer-confession",
     "text": "Father, I also bring you what I regret.",
     "start": 237.575,
     "end": 240.796
    },
    {
     "segment": "prayer-confession",
     "text": "The impatient word.",
     "start": 240.976,
     "end": 242.832
    },
    {
     "segment": "prayer-confession",
     "text": "The thing I should have done and did not.",
     "start": 243.012,
     "end": 245.913
    },
    {
     "segment": "prayer-confession",
     "text": "The moment I chose myself over someone else.",
     "start": 246.093,
     "end": 249.677
    },
    {
     "segment": "prayer-confession",
     "text": "I do not want to carry guilt into my sleep.",
     "start": 249.857,
     "end": 253.057
    },
    {
     "segment": "prayer-confession",
     "text": "I confess it to you honestly, and I receive your forgiveness.",
     "start": 253.237,
     "end": 257.888
    },
    {
     "segment": "scripture-4",
     "text": "If we confess our sins, he is faithful and just to forgive us our sins, and to cleanse us from all unrighteousness.",
     "start": 259.268,
     "end": 268.377
    },
    {
     "segment": "reflection-4",
     "text": "Faithful and just.",
     "start": 270.057,
     "end": 271.849
    },
    {
     "segment": "reflection-4",
     "text": "God does not forgive you reluctantly.",
     "start": 272.029,
     "end": 274.995
    },
    {
     "segment": "reflection-4",
     "text": "He forgives you because he promised he would, and he always keeps his promises.",
     "start": 275.175,
     "end": 280.7
    },
    {
     "segment": "reflection-4",
     "text": "So tonight you can lay your head down clean.",
     "start": 280.88,
     "end": 284.272
    }
   ],
