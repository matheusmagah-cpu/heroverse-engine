    },
    {
     "segment": "reflection-6",
     "text": "He sees you as clearly at midnight as he did at noon.",
     "start": 431.084,
     "end": 435.244
    },
    {
     "segment": "reflection-6",
     "text": "Nothing that happens in the dark is hidden from him, and nothing in the dark can separate you from his love.",
