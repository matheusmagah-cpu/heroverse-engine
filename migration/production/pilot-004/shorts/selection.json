     "end": 165.019
    },
    {
     "segment": "scripture-3",
     "text": "and ye shall find rest unto your souls.",
     "start": 165.199,
     "end": 168.207
    },
    {
     "segment": "scripture-3",
     "text": "For my yoke is easy, and my burden is light.",
     "start": 168.387,
     "end": 172.056
    },
    {
     "segment": "reflection-3",
     "text": "Jesus promises rest for your souls.",
     "start": 173.736,
     "end": 176.851
    },
    {
